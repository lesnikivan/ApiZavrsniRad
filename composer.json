{
    "name": "plant-care/backend",
    "description": "Backend API for AI plant identification, history storage, and Trello task creation.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "monolog/monolog": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8000 -t public",
        "test": "phpunit"
    }
}